{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "//": "Los secretos NO van aquí. En local se leen de appsettings.Development.json; en la nube, de variables de entorno: ConnectionStrings__DefaultConnection, Jwt__Key, Seed__AdminPassword y Cors__AllowedOrigins__0 (__1, __2... para orígenes adicionales).",
  "Jwt": {
    "Issuer": "NominaApi",
    "Audience": "NominaBackoffice",
    "ExpiresMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Deploy": {
    "MigrateOnStartup": true
  },
  "Contabilidad": {
    "BaseUrl": "https://sistema-contabilidad.onrender.com",
    "AuxiliarId": 2,
    "TimeoutSegundos": 90,
    "ReintentosEnvio": 2,
    "Cuentas": {
      "GastoNomina": "501",
      "NominaPorPagar": "202"
    }
  }
}
